# ---------------------------------------------------------------------------
# Copie este arquivo para .env e ajuste. O .env NAO vai para o git.
# ---------------------------------------------------------------------------

# Porta e interface do servidor. 0.0.0.0 libera acesso pela rede local.
PORTA=3001
HOST=0.0.0.0

# Origens autorizadas a chamar a API (CORS), separadas por virgula.
# Em desenvolvimento o Vite roda na 5173. No servidor da rede, use o IP real:
#   ORIGENS_PERMITIDAS=http://192.168.0.50:5173,http://192.168.0.50:3001
ORIGENS_PERMITIDAS=http://localhost:5173,http://127.0.0.1:5173

# Senha simples exigida de quem usa o sistema (opcional, recomendada em rede).
# Nao tem relacao com a chave da Anthropic.
# SENHA_ACESSO=troque-esta-senha

# Chave da API Anthropic.
# Prefira "npm run chave:definir" (grava cifrada em secrets/). Esta variavel
# existe para ambientes onde o segredo ja vem do orquestrador.
# ANTHROPIC_API_KEY=sk-ant-...

# Senha que protege o cofre. Se ficar vazia, o sistema gera secrets/.chave-mestra.
# Definindo aqui, o cofre viaja junto com a maquina que conhece a senha.
# CHAVE_MESTRA=

# Ajustes da IA
IA_MAX_TOKENS=1500
IA_TIMEOUT_MS=45000
# Raciocinio adaptativo do Sonnet 5. "ligado" melhora casos dificeis e custa
# mais tokens; "desligado" (padrao) e suficiente para estas tarefas curtas.
IA_PENSAMENTO=desligado

# Limite de consultas por IP por minuto.
LIMITE_REQ_MINUTO=30
